# SR-139: single same-origin front. Caddy serves the built SPA and
# reverse-proxies the API prefixes to the backend containers, so the browser
# only ever talks to one origin (no CORS, no per-host rebuild).
#
# TLS is terminated at the edge (Cloudflare Access + Tunnel) in production,
# and plain HTTP locally, so auto_https is off here.
{
	admin off
	auto_https off
}

:80 {
	# PlantUML SVG generation. handle_path strips the /plantuml prefix, so
	# /plantuml/svg/<enc> -> plantuml:8080/svg/<enc>.
	handle_path /plantuml/* {
		reverse_proxy plantuml:8080
	}

	# N-switch coverage API.
	handle_path /nswitch/* {
		reverse_proxy nswitch-api:8090
	}

	# Sister-project demo API, co-located on this shared box (path-based).
	# NeoCombi's PICT service: public, no gate — it runs untrusted DSL through
	# the PICT binary and holds no secrets; its own rate-limit / timeout /
	# body-size guardrails apply (see pict-service/server.mjs). The service is
	# defined in docker-compose.override.yml (server-only), built from
	# /opt/pict-service. handle_path strips /pict, so /pict/health -> /health.
	handle_path /pict/* {
		reverse_proxy pict-service:8765
	}

	# Sister-project demo API, co-located on this shared box (path-based).
	# NeoCEG's cause-effect-graph API (serve mode, CLI spec §7): public, no gate
	# — it holds no secrets and applies its own body-size / rate-limit
	# guardrails in-process. Defined in docker-compose.override.yml
	# (server-only), built from /opt/neoceg. handle_path strips /neoceg, so
	# /neoceg/health -> /health.
	handle_path /neoceg/* {
		reverse_proxy neoceg-api:8091
	}

	# Sister-project static content, co-located on this shared box (path-based).
	# KASANE STORE checkout benchmark: a purely static MOCK checkout/payment site
	# for data-driven & combinatorial test practice. Public; no gate. It sets no
	# cookies, makes no network requests (CSP connect-src 'none'), and holds no
	# secrets. Bind-mounted read-only from /opt/sites/checkout-benchmark by the
	# server-only docker-compose.override.yml; deployed from its own repo
	# (github.com/sho1884/checkout-benchmark) with the restricted rsync-only
	# content key — never through this repo. This route is the only file here that
	# knows about it. The site's own SERVER-SECURITY.md requires frame-ancestors /
	# X-Frame-Options as real HTTP headers (a <meta> CSP cannot set them), so we
	# reproduce its _headers here.
	# Canonical trailing slash: /checkout-benchmark -> /checkout-benchmark/ so
	# the page's relative asset paths resolve. Three explicit args
	# (matcher, destination, code) — a two-arg `redir /path/ 308` would parse the
	# leading-slash destination as the matcher and set "Location: 308".
	redir /checkout-benchmark /checkout-benchmark/ 308
	handle_path /checkout-benchmark/* {
		root * /srv/sites/checkout-benchmark
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), web-share=(), xr-spatial-tracking=()"
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Embedder-Policy require-corp
			Cross-Origin-Resource-Policy same-origin
			Cache-Control no-cache
			-Server
		}
		file_server
	}

	# 医療保険引受判定 演習サイト (medical-underwriting): a purely static MOCK
	# insurance-underwriting site for cause-effect-graph test-design practice.
	# Same co-location pattern as /checkout-benchmark above: no cookies, no
	# network requests (CSP connect-src 'none'), no secrets. Bind-mounted :ro
	# from /opt/sites/medical-underwriting by the server-only override.yml;
	# deployed from its own PRIVATE repo (github.com/sho1884/medical-underwriting
	# — private because it contains the exercise answer model) with the
	# restricted rsync-only content key. This route is the only file here that
	# knows about it.
	redir /medical-underwriting /medical-underwriting/ 308
	handle_path /medical-underwriting/* {
		root * /srv/sites/medical-underwriting
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), web-share=(), xr-spatial-tracking=()"
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Embedder-Policy require-corp
			Cross-Origin-Resource-Policy same-origin
			Cache-Control no-cache
			-Server
		}
		file_server
	}

	# 契約保全 演習サイト (policy-servicing): sister of /medical-underwriting — a
	# purely static MOCK policy-servicing simulator for state-transition test
	# design practice (the ModelLogue state-machine example). Same co-location
	# pattern and the same headers as /medical-underwriting: no cookies, no
	# network requests, no secrets. Bind-mounted :ro from
	# /opt/sites/policy-servicing by the server-only override.yml; deployed from
	# its own PRIVATE repo (it contains the exercise answer model) with the
	# restricted rsync-only content key. This route is the only file here that
	# knows about it.
	redir /policy-servicing /policy-servicing/ 308
	handle_path /policy-servicing/* {
		root * /srv/sites/policy-servicing
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), web-share=(), xr-spatial-tracking=()"
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Embedder-Policy require-corp
			Cross-Origin-Resource-Policy same-origin
			Cache-Control no-cache
			-Server
		}
		file_server
	}

	# SR-136/137: identity probe for the front-end AI gate. Reports the
	# operator's authenticated identity as seen by the edge auth gate
	# (Cloudflare Access sets Cf-Access-Authenticated-User-Email once it has
	# authenticated the request). With no gate / an anonymous visitor the
	# header is absent and we return 401 {"authenticated":false}, so the SPA
	# shows the AI-free app. This endpoint reads a header, so the auth gate
	# provider is swappable (map its identity header here — NFR-091).
	handle /auth/whoami {
		header Content-Type application/json
		@authed header Cf-Access-Authenticated-User-Email *
		respond @authed `{"authenticated":true}` 200
		respond `{"authenticated":false}` 401
	}

	# SR-140: Sign-in entry point. Navigating here (a top-level navigation
	# from the SPA's "Sign in" button) triggers the edge auth gate's login
	# (Cloudflare Access etc.) because this path is gate-protected in prod.
	# Once past the gate we bounce back to the app, which re-probes
	# /auth/whoami and shows the chat pane. With no gate in front this simply
	# returns to / and the user stays unauthenticated (fail-safe).
	redir /auth/login /app 302

	# n8n: ONLY the relay webhooks and the liveness probe are exposed. The
	# n8n editor / admin UI (which holds the Gemini credential) is
	# deliberately NOT proxied — the operator reaches it via SSH / compose
	# exec. Any other /n8n/* path falls through to the SPA handler below.

	# Liveness probe — open, carries no identity.
	handle /n8n/healthz {
		uri strip_prefix /n8n
		reverse_proxy n8n:5678
	}

	# SR-137: the AI relay is the gated boundary. Every webhook request is
	# verified by the auth-verify service (Cloudflare Access JWT); Caddy only
	# proxies on to n8n when it answers 2xx, so an unauthenticated call never
	# reaches a Gemini node — independently of the edge routing, and even if
	# the SPA gate (SR-136) is bypassed. auth-verify fails closed when the CF
	# env is unset (see tools/authgate).
	handle /n8n/webhook/* {
		forward_auth auth-verify:8092 {
			uri /verify
			copy_headers Cf-Access-Authenticated-User-Email
		}
		uri strip_prefix /n8n
		reverse_proxy n8n:5678
	}

	# Retire the app's OLD root-scoped service worker: serve a self-destroying
	# /sw.js with no-cache so legacy clients revalidate, update to it, and clean
	# up (see deploy/sw.js). New clients never register a worker here.
	handle /sw.js {
		root * /srv
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	# The app's own service worker must never be edge/browser-cached, or an
	# autoUpdate after a deploy can be blocked by a stale copy (same failure mode
	# as the legacy root worker above). Serve it revalidated.
	handle /app/sw.js {
		root * /srv
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	# The app (SPA) lives under /app. It is built with base /app/, so its assets
	# are /app/assets/… served from /srv/app. History-API fallback to the SPA
	# shell (/srv/app/index.html) for client-side routes under /app.
	handle /app* {
		root * /srv
		try_files {path} /app/index.html
		file_server
	}

	# Co-located static content at the site root (everything else). This is NOT
	# part of the tool: it is bind-mounted read-only from /opt/sites/<name> by
	# the server-only docker-compose.override.yml, and deployed from its own
	# repo with the restricted rsync-only content key — never through this repo
	# (same rule as /neoceg and /pict above). This route is the only file here
	# that knows about it. The SPA's own shell is /srv/app/index.html above.
	handle {
		root * /srv/sites/modellogue-site
		try_files {path} /index.html
		file_server
	}
}
