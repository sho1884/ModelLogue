# SR-139: single same-origin front. Caddy serves the built SPA and
# reverse-proxies the API prefixes to the backend containers, so the browser
# only ever talks to one origin (no CORS, no per-host rebuild).
#
# TLS is terminated at the edge (Cloudflare Access + Tunnel) in production,
# and plain HTTP locally, so auto_https is off here.
{
	admin off
	auto_https off
}

:80 {
	# PlantUML SVG generation. handle_path strips the /plantuml prefix, so
	# /plantuml/svg/<enc> -> plantuml:8080/svg/<enc>.
	handle_path /plantuml/* {
		reverse_proxy plantuml:8080
	}

	# N-switch coverage API.
	handle_path /nswitch/* {
		reverse_proxy nswitch-api:8090
	}

	# Sister-project demo API, co-located on this shared box (path-based).
	# NeoCombi's PICT service: public, no gate — it runs untrusted DSL through
	# the PICT binary and holds no secrets; its own rate-limit / timeout /
	# body-size guardrails apply (see pict-service/server.mjs). The service is
	# defined in docker-compose.override.yml (server-only), built from
	# /opt/pict-service. handle_path strips /pict, so /pict/health -> /health.
	handle_path /pict/* {
		reverse_proxy pict-service:8765
	}

	# SR-136/137: identity probe for the front-end AI gate. Reports the
	# operator's authenticated identity as seen by the edge auth gate
	# (Cloudflare Access sets Cf-Access-Authenticated-User-Email once it has
	# authenticated the request). With no gate / an anonymous visitor the
	# header is absent and we return 401 {"authenticated":false}, so the SPA
	# shows the AI-free app. This endpoint reads a header, so the auth gate
	# provider is swappable (map its identity header here — NFR-091).
	handle /auth/whoami {
		header Content-Type application/json
		@authed header Cf-Access-Authenticated-User-Email *
		respond @authed `{"authenticated":true}` 200
		respond `{"authenticated":false}` 401
	}

	# SR-140: Sign-in entry point. Navigating here (a top-level navigation
	# from the SPA's "Sign in" button) triggers the edge auth gate's login
	# (Cloudflare Access etc.) because this path is gate-protected in prod.
	# Once past the gate we bounce back to the app, which re-probes
	# /auth/whoami and shows the chat pane. With no gate in front this simply
	# returns to / and the user stays unauthenticated (fail-safe).
	redir /auth/login /app 302

	# n8n: ONLY the relay webhooks and the liveness probe are exposed. The
	# n8n editor / admin UI (which holds the Gemini credential) is
	# deliberately NOT proxied — the operator reaches it via SSH / compose
	# exec. Any other /n8n/* path falls through to the SPA handler below.

	# Liveness probe — open, carries no identity.
	handle /n8n/healthz {
		uri strip_prefix /n8n
		reverse_proxy n8n:5678
	}

	# SR-137: the AI relay is the gated boundary. Every webhook request is
	# verified by the auth-verify service (Cloudflare Access JWT); Caddy only
	# proxies on to n8n when it answers 2xx, so an unauthenticated call never
	# reaches a Gemini node — independently of the edge routing, and even if
	# the SPA gate (SR-136) is bypassed. auth-verify fails closed when the CF
	# env is unset (see tools/authgate).
	handle /n8n/webhook/* {
		forward_auth auth-verify:8092 {
			uri /verify
			copy_headers Cf-Access-Authenticated-User-Email
		}
		uri strip_prefix /n8n
		reverse_proxy n8n:5678
	}

	# The app (SPA) lives under /app. It is built with base /app/, so its assets
	# are /app/assets/… served from /srv/app. History-API fallback to the SPA
	# shell (/srv/app/index.html) for client-side routes under /app.
	handle /app* {
		root * /srv
		try_files {path} /app/index.html
		file_server
	}

	# Static landing page at the site root (everything else). /srv/index.html is
	# the landing; the SPA's own shell is /srv/app/index.html above.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
