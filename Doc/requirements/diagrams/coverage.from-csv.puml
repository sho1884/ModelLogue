  $fReq("SR-115", "Seed new requirement-diagram sessions with the !procedure preamble so the edit buffer is a valid PlantUML source from the first keystroke")
  $fReq("SR-116", "Apply an AI chat reply to a requirement-diagram session: extract the ```csv block, regenerate canonical PlantUML mechanically, auto-apply without a before/after modal")
  $fReq("SR-117", "Auto-place green/amber added/changed markers on the requirement diagram after an AI apply, cleared on every source change")
  $fReq("SR-118", "Persist level (user/system/design) and group (free-text) classification axes on requirements")
  $fReq("SR-119", "Render requirement diagram with selectable visual grouping axis (type / level / group)")
  $fReq("SR-120", "Scenarios tab — enumerate every start→end path in the process diagram, one row per path")
  $fReq("SR-121", "Events tab — list every `<<timer>>` / `<<message>>` / `<<error>>` event with the paths that contain it")
  $fReq("SR-122", "Roles tab — list every swim lane with its tasks and the hand-off points to other lanes")
  $fReq("SR-123", "Artifacts tab (optional) — list every `-> 伝票名;` arrow label with the tasks that produce / consume it")
  $fReq("SR-124", "Parse process-diagram source (PlantUML activity subset, §3.15.3) into ProcessModel")
  $fReq("SR-125", "Externals tab — list external IT systems / repositories referenced from task notes, with their touching tasks")
